{"is_source_file": true, "format": "JSON", "description": "This file contains metadata for the 'Vector.sub' method, including documentation, examples, and associated header lines.", "external_files": ["lu5_vector.h"], "external_methods": ["Vector.sub"], "published": [], "classes": [], "methods": [{"name": "Vector.sub", "description": "Returns the vector resulting from subtracting vector b from vector a. Supports both mutable and non-mutable operations.", "examples": ["local a = createVector(3, 5);", "local b = createVector(2, 3);", "-- Non-mutable", "print(Vector.sub(a, b)); -- { 1.0, 2.0 }", "print(a - b);            -- { 1.0, 2.0 }", "print(a);                -- { 3.0, 5.0 }", "-- Mutable", "print(a:sub(b)); -- { 1.0, 2.0 }", "print(a);        -- { 1.0, 2.0 }"], "calls": ["arguments: a - The first vector", "arguments: b - The second vector"]}], "calls": ["Vector.sub"], "search-terms": ["Vector.sub", "vector subtraction", "vector method", "math operation", "mutable vector subtraction"], "state": 2, "file_id": 1175, "knowledge_revision": 2671, "git_revision": "270ff1cf7225ce2e4cb5a69e392717e4275033a5", "hash": "d03dd08550f40493a82a9230528971da", "format-version": 4, "code-base-name": "lu5-327603", "filename": "docs/v0.1.6/vector/Vector.sub/meta.json", "revision_history": [{"2671": "270ff1cf7225ce2e4cb5a69e392717e4275033a5"}]}